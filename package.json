{
  "name": "hardware-lab-ims",
  "version": "2.2.0",
  "description": "Hardware Lab Inventory Management System: browser app with a MySQL database",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "init-db": "node --env-file=.env scripts/init-db.js",
    "init-db:sample": "node --env-file=.env scripts/init-db.js --sample",
    "create-admin": "node --env-file=.env scripts/create-admin.js",
    "backup": "node --env-file=.env scripts/backup.js",
    "test": "node --env-file=.env --test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mysql2": "^3.11.0"
  }
}
