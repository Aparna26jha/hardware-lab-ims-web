# Copy this file to .env and fill in the values.
# development = test copy (sample sign-in buttons and "Reset sample data" are allowed)
# production  = real lab data (both are switched off)
APP_ENV=development

# Web address: http://<server-ip>:PORT
PORT=8080
HOST=0.0.0.0

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ims_dev
DB_USER=ims_app
DB_PASSWORD=change-me

# Uploaded invoices, delivery notes and feedback screenshots
UPLOAD_DIR=./data/uploads

# Backups. Use a different drive or a network share in real use.
BACKUP_DIR=./data/backups
BACKUP_HOUR=1
BACKUP_KEEP_DAYS=30

# Sign-in lasts this many hours
SESSION_HOURS=10
# Set to true only when the site is served over https
COOKIE_SECURE=false

# Expiry warning starts this many months before the expiry date
EXPIRY_WARN_MONTHS=6
